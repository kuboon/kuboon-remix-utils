{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsr.io/@kuboon/remix-onboarding-kit/schema.json",
  "title": "Remix onboarding tour",
  "description": "A product tour: an ordered walkthrough of a page, each step spotlighting a target and anchoring a tooltip to it.",
  "type": "object",
  "required": ["name", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Identifies the tour where completion is stored. Must be unique per app."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Bump after editing a tour to show it again to people who finished the old one."
    },
    "autoStart": { "type": "boolean", "default": true },
    "keyboard": {
      "type": "boolean",
      "default": true,
      "description": "Bind ArrowRight/Enter (next), ArrowLeft (back) and Escape (skip) while running."
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "description": "Button and progress text, so the scenario carries its own language.",
      "properties": {
        "next": { "type": "string" },
        "back": { "type": "string" },
        "skip": { "type": "string" },
        "done": { "type": "string", "description": "Label of the button on the last step." },
        "progress": {
          "type": "string",
          "description": "Progress template. {index} (1-based) and {total} are substituted."
        }
      }
    },
    "defaults": { "$ref": "#/$defs/stepDefaults" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "placement": {
      "type": "string",
      "description": "Preferred tooltip side. Flips to the opposite side when it would overflow.",
      "enum": [
        "top",
        "top-start",
        "top-end",
        "bottom",
        "bottom-start",
        "bottom-end",
        "left",
        "left-start",
        "left-end",
        "right",
        "right-start",
        "right-end"
      ]
    },
    "whenMissing": {
      "type": "string",
      "description": "What to do when the target selector matches nothing.",
      "enum": ["skip", "wait", "center", "fail"],
      "default": "skip"
    },
    "point": {
      "type": "object",
      "description": "A fixed rectangle in viewport coordinates.",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "stepDefaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Step options set once for the whole tour.",
      "properties": {
        "placement": { "$ref": "#/$defs/placement" },
        "offset": { "type": "number", "default": 12 },
        "spotlight": { "type": "boolean", "default": true },
        "spotlightPadding": { "type": "number", "minimum": 0, "default": 6 },
        "scrollIntoView": { "type": "boolean", "default": true },
        "whenMissing": { "$ref": "#/$defs/whenMissing" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Stable id, for goto() and analytics." },
        "target": {
          "description": "A CSS selector, or a fixed viewport rectangle. Omit for a centered card with no subject.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/point" }
          ]
        },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "placement": { "$ref": "#/$defs/placement" },
        "offset": { "type": "number" },
        "spotlight": { "type": "boolean" },
        "spotlightPadding": { "type": "number", "minimum": 0 },
        "scrollIntoView": { "type": "boolean" },
        "whenMissing": { "$ref": "#/$defs/whenMissing" }
      }
    }
  }
}

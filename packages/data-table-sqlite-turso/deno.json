    "./cli": "./src/cli.ts"
  },
  "imports": {
    "@remix-run/data-table": "npm:@remix-run/data-table@^0.4.0",
    "@remix-run/data-table/cli": "npm:@remix-run/data-table@^0.4.0/cli",
